#!/bin/bash
# IntelGraph analytics/detection node. Runs the API + graph on :8000, reachable
# only from within the lab VPC. This is the system under test.
#
# All registry/region values are injected by Terraform (no shell parsing), so
# this script stays POSIX-simple and can't trip cloud-init's parser.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
%{ if ecr_registry != "" ~}
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${ecr_registry}
%{ endif ~}
docker pull ${intelgraph_image}
docker run -d --restart unless-stopped --name intelgraph \
  -p 8000:8000 \
  -e INTELGRAPH_SECRET_KEY='${secret_key}' \
  -e INTELGRAPH_DEPLOYMENT=lab \
  ${intelgraph_image}
