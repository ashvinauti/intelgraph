#!/bin/bash
# Benign "command-and-control" EMULATION node. It does two harmless things,
# entirely within the lab VPC:
#   1. Serves a static HTTP endpoint on :8080 that victim nodes "beacon" to.
#   2. On a timer, pushes synthetic IOC campaigns into IntelGraph using the
#      built-in `intelgraph simulate network` generator (documentation-space
#      indicators only). No real C2, no real payloads.
#
# Registry/region/target values are injected by Terraform (no shell parsing).
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
%{ if ecr_registry != "" ~}
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${ecr_registry}
%{ endif ~}
docker pull ${intelgraph_image}

# 1. Static "C2 panel" listener (serves a canned beacon acknowledgement).
mkdir -p /opt/c2/www
echo 'beacon-ack' > /opt/c2/www/beacon
echo '<html><body>lab c2 emulation panel</body></html>' > /opt/c2/www/index.html
docker run -d --restart unless-stopped --name c2panel \
  -p 8080:8080 -v /opt/c2/www:/www:ro \
  python:3.11-slim python -m http.server 8080 --directory /www

# 2. Telemetry generator. Written with a quoted heredoc (no expansion here),
#    then Terraform values are substituted with sed so nothing needs escaping.
cat > /usr/local/bin/ig-simulate <<'EOS'
#!/bin/bash
set -e
SEED=$RANDOM
docker run --rm __IMAGE__ uv run intelgraph simulate network \
  --seed "$SEED" --campaigns __CAMPAIGNS__ --overlap 0.5 --ipv6 \
  --feed --base-url http://__ANALYTICS__:8000
EOS
sed -i "s#__IMAGE__#${intelgraph_image}#; s#__CAMPAIGNS__#${sim_campaigns}#; s#__ANALYTICS__#${analytics_ip}#" /usr/local/bin/ig-simulate
chmod +x /usr/local/bin/ig-simulate

cat > /etc/systemd/system/ig-simulate.service <<'EOS'
[Unit]
Description=Push synthetic IOC campaigns into IntelGraph (lab emulation)
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/ig-simulate
EOS

cat > /etc/systemd/system/ig-simulate.timer <<EOS
[Unit]
Description=Run IntelGraph synthetic feed every ${sim_interval_min} minutes
[Timer]
OnBootSec=3min
OnUnitActiveSec=${sim_interval_min}min
Persistent=true
[Install]
WantedBy=timers.target
EOS

systemctl daemon-reload
systemctl enable --now ig-simulate.timer
